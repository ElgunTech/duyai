# Bu faylı .env adı ilə kopyalayın və dəyərləri doldurun.

# Azure Speech (portal.azure.com → Speech service → Keys and Endpoint)
AZURE_SPEECH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_SPEECH_REGION=uaenorth

# Azure Translator (portal.azure.com → Translator, Free F0 → Keys and Endpoint)
# Live translation; without it Claude translates.
AZURE_TRANSLATOR_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_TRANSLATOR_REGION=uaenorth
# TRANSLATION_ENGINE=claude   # Claude translation + auto-answer + AI risk rating

# Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Hesabat modeli (keyfiyyət) və canlı tərcümə modeli (sürət)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FAST_MODEL=claude-opus-5-5

PORT=3000
